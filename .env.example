# Pagouro environment. Copy to .env and fill in. .env is gitignored — never commit it.

# OpenRouter API key. Get one at https://openrouter.ai/keys and set a credit limit on it.
# Format: sk-or-v1-...
OPENROUTER_API_KEY=

# Optional: app attribution on OpenRouter's leaderboards.
OPENROUTER_APP_TITLE=Pagouro
OPENROUTER_APP_URL=

# Optional: default model slug for scratch work. See https://openrouter.ai/models
OPENROUTER_DEFAULT_MODEL=
